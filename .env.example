# EthioVuln Environment Configuration Template
# Copy this file to backend/.env (and root .env for Docker) and configure your secrets

# ─── Environment & Hardening ──────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true
ENABLE_API_DOCS=true

# ─── Database (PostgreSQL 16) ────────────────────────────────────────────────
# Use port 5433 when mapping from Docker, or 5432 for native PostgreSQL
DATABASE_URL=postgresql+asyncpg://dast:dast_secret@localhost:5433/dast_db
DATABASE_URL_SYNC=postgresql://dast:dast_secret@localhost:5433/dast_db

# ─── Cache & Message Broker (Redis 7) ────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Authentication & Security ───────────────────────────────────────────────
# Generate a secure 32+ character key: openssl rand -hex 32
SECRET_KEY=3f8a2e1d9c7b4f6a0e5d3c2b1a9f8e7d6c5b4a3e2d1f0e9d8c7b6a5f4e3d2c1
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Application URLs ────────────────────────────────────────────────────────
APP_NAME=EthioVuln
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# ─── Scanning Engines ────────────────────────────────────────────────────────
ZAP_API_URL=http://localhost:8080
ZAP_API_KEY=changeme
NUCLEI_PATH=/usr/bin/nuclei

# ─── Fuzzer Tuning ───────────────────────────────────────────────────────────
FUZZER_THREADS=30
FUZZER_TIMEOUT=5
FUZZER_RATE_LIMIT=0.0

# ─── Google Gemini AI Intelligence (Optional) ────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
